{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://xinka.ai/schema/xinka-0.3.json",
  "title": "Xinka Card",
  "description": "Xinka（信卡）——可信知识的最小单元。六要素：源(Source)/采(Collected)/信(Trust)/鲜(Freshness)/位(Position)/证(Verified)。Xinka Specification Early Draft v0.3 · Created by Ren Shiliao (任世燎)。v0.2 增补：R9 源分级(sources.tier)/R10 引文绑定(evidence.sha256)/快照(snapshots)；v0.3 增补（标准完善·为将来做好准备）：card_type 卡种枚举（knowledge/ability/troubleshoot/ledger/mind）、能力卡必填「骨架句」、排障卡必填「症状词/判死法/修法」三段、trust_level 增 empirical（实证型）档——字段名与心网 v4 架构规格字段表对齐，禁改名。",
  "type": "object",
  "required": [
    "xinka_version",
    "card_type",
    "claim",
    "source_url",
    "collected_at",
    "trust_level",
    "freshness_until",
    "position",
    "verification"
  ],
  "additionalProperties": false,
  "properties": {
    "xinka_version": {
      "type": "string",
      "description": "信卡结构版本号（兼容性判定）",
      "pattern": "^0\\.[0-9]+$"
    },
    "card_type": {
      "type": "string",
      "enum": [
        "knowledge",
        "ability",
        "troubleshoot",
        "ledger",
        "mind"
      ],
      "description": "【卡种】v0.3 必填枚举（对应 META 组块）：knowledge=知识卡（组块:知识）/ ability=能力卡（组块:能力·事情骨架）/ troubleshoot=排障卡（组块:排障·事故件）/ ledger=台账卡（组块:台账）/ mind=心法卡（组块:心法）"
    },
    "claim": {
      "type": "string",
      "description": "知识断言本体——不可再拆而保持语义完整的最小命题",
      "minLength": 4,
      "maxLength": 500
    },
    "source_url": {
      "type": "string",
      "format": "uri",
      "description": "【源】原始出处 URL——无出处则任何引用不成立",
      "pattern": "^https?://"
    },
    "collected_at": {
      "type": "string",
      "format": "date-time",
      "description": "【采】采集时刻（RFC 3339）——同 URL 内容会变，不记采集时间则档案无法复现"
    },
    "trust_level": {
      "type": "string",
      "enum": [
        "verified",
        "empirical",
        "pending"
      ],
      "description": "【信】置信度三档：verified=已验证（外部事实断言须三源互证）/ empirical=实证型（本机一手实证+复现判死法即达此档，不强求 3 外部源）/ pending=待核验"
    },
    "freshness_until": {
      "type": "string",
      "format": "date-time",
      "description": "【鲜】保鲜期截止（RFC 3339）——到期未复核自动降级 pending"
    },
    "position": {
      "type": "string",
      "description": "【位】知识树内坐标，层级用 / 分隔（如 ai/models/open-weights/mimo）",
      "pattern": "^[a-z0-9\\-]+(/[a-z0-9\\-\\.]+)*$",
      "maxLength": 200
    },
    "骨架句": {
      "type": [
        "string",
        "array"
      ],
      "description": "【能力卡必填·v0.3】事情骨架：步可跑、名物可换（数组=逐行骨架步，字符串=单行骨架句）。字段名与心网 v4 架构规格字段表一致，禁改名。",
      "minLength": 2,
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 2
      }
    },
    "症状词": {
      "type": [
        "string",
        "array"
      ],
      "description": "【排障卡必填·v0.3】事故症状锚词（反挂索引：症状词→排障卡号）。字段名与心网 v4 架构规格字段表一致，禁改名。",
      "minLength": 1,
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "判死法": {
      "type": "string",
      "description": "【排障卡必填·v0.3】怎么判死（复现/判别步骤，机器可跑）——empirical 档的复现依据。字段名与心网 v4 架构规格字段表一致，禁改名。",
      "minLength": 4
    },
    "修法": {
      "type": "string",
      "description": "【排障卡必填·v0.3】怎么修（可执行修法）。字段名与心网 v4 架构规格字段表一致，禁改名。",
      "minLength": 4
    },
    "verification": {
      "type": "object",
      "description": "【证】互证记录——外部事实断言孤证不立；实证型（empirical）凭一手实证记录+复现判死法成档",
      "required": [
        "method",
        "sources",
        "checked_at"
      ],
      "additionalProperties": false,
      "properties": {
        "method": {
          "type": "string",
          "description": "校验方法（如 three-source cross-check / 本机一手实证+复现判死法）"
        },
        "sources": {
          "type": "array",
          "description": "参与互证的独立来源 URL 列表；verified 档要求 ≥3 且互不相同；empirical 档不强求外部源",
          "items": {
            "oneOf": [
              {
                "type": "string",
                "format": "uri"
              },
              {
                "type": "object",
                "required": [
                  "url"
                ],
                "additionalProperties": false,
                "properties": {
                  "url": {
                    "type": "string",
                    "format": "uri",
                    "description": "证源 URL"
                  },
                  "tier": {
                    "type": "string",
                    "enum": [
                      "first-party",
                      "media",
                      "aggregator",
                      "unknown"
                    ],
                    "description": "R9 源分级：一手/媒体/聚合/未知"
                  },
                  "note": {
                    "type": "string",
                    "description": "first-party 申报依据（白名单外域名必填）"
                  }
                }
              }
            ]
          }
        },
        "checked_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time",
          "description": "校验时刻；未校验时为 null"
        }
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "description": "R10 引文绑定——引文逐字出自对应源，sha256=抓取正文指纹（复检比对防改稿/防编造）；empirical 档经验卡免绑（v0.3 分型）",
      "items": {
        "type": "object",
        "required": [
          "url",
          "quote",
          "sha256",
          "fetched_at"
        ],
        "additionalProperties": false,
        "properties": {
          "url": {
            "type": "string",
            "format": "uri",
            "description": "引文所属证源（须在 sources 内）"
          },
          "quote": {
            "type": "string",
            "minLength": 8,
            "maxLength": 300,
            "description": "原文引文（≥8 字·逐字）"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$",
            "description": "抓取正文归一化后 sha256 指纹"
          },
          "fetched_at": {
            "type": "string",
            "format": "date-time",
            "description": "抓取时刻"
          }
        }
      }
    },
    "snapshots": {
      "type": "object",
      "description": "archive.org 快照存档（尽力而为）：source_url → snapshot_url",
      "additionalProperties": {
        "type": "string",
        "format": "uri"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "card_type": {
            "const": "ability"
          }
        },
        "required": [
          "card_type"
        ]
      },
      "then": {
        "required": [
          "骨架句"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "card_type": {
            "const": "troubleshoot"
          }
        },
        "required": [
          "card_type"
        ]
      },
      "then": {
        "required": [
          "症状词",
          "判死法",
          "修法"
        ]
      }
    }
  ]
}
